{
  "name": "git",
  "description": "Complete Git knowledge from official documentation. Use when version controlling source code. Covers branching, merging, rebasing, and workflows.",
  "version": "1.0.0",
  "base_url": "https://git-scm.com/doc",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://git-scm.com/doc",
      "start_urls": [
        "https://git-scm.com/doc",
        "https://git-scm.com/book/en/v2",
        "https://git-scm.com/docs",
        "https://git-scm.com/docs/gittutorial"
      ],
      "selectors": {
        "main_content": "article, main, #content",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/book/en/v2/",
          "/docs/",
          "/docs/gittutorial"
        ],
        "exclude": [
          "/docs/api/"
        ]
      },
      "categories": {
        "getting_started": [
          "",
          "gittutorial",
          "git-basics",
          "installing"
        ],
        "git_basics": [
          "book/en/v2/Getting-Started-Git-Basics",
          "book/en/v2/Git-Basics-Getting-a-Git-Repository",
          "book/en/v2/Git-Basics-Recording-Changes-to-the-Repository"
        ],
        "branching": [
          "book/en/v2/Git-Branching-Branches-in-a-Nutshell",
          "book/en/v2/Git-Branching-Basic-Branching-and-Merging",
          "branch"
        ],
        "merging": [
          "book/en/v2/Git-Branching-Basic-Branching-and-Merging",
          "merge",
          "merge-conflicts",
          "merge-strategies"
        ],
        "rebasing": [
          "book/en/v2/Git-Branching-Rebasing",
          "rebase",
          "interactive-rebase",
          "rebase-vs-merge"
        ],
        "remote": [
          "book/en/v2/Git-Basics-Working-with-Remotes",
          "remote",
          "fetch",
          "push",
          "pull",
          "clone"
        ],
        "history": [
          "book/en/v2/Git-Basics-Viewing-the-Commit-History",
          "log",
          "diff",
          "show",
          "blame"
        ],
        "undoing": [
          "book/en/v2/Git-Basics-Undoing-Things",
          "reset",
          "revert",
          "checkout",
          "restore"
        ],
        "staging": [
          "book/en/v2/Git-Tools-Interactive-Staging",
          "add",
          "stash",
          "stage"
        ],
        "tagging": [
          "book/en/v2/Git-Basics-Tagging",
          "tag",
          "annotated-tags",
          "lightweight-tags"
        ],
        "workflows": [
          "book/en/v2/Distributed-Git-Distributed-Workflows",
          "centralized-workflow",
          "feature-branch",
          "gitflow",
          "forking"
        ],
        "hooks": [
          "book/en/v2/Customizing-Git-Git-Hooks",
          "hooks",
          "pre-commit",
          "post-merge"
        ],
        "submodules": [
          "book/en/v2/Git-Tools-Submodules",
          "submodule",
          "subtree"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Git Community",
    "language": "Shell",
    "framework_type": "Version Control",
    "use_cases": [
      "Source control",
      "Collaboration",
      "Version history",
      "Code review",
      "Release management"
    ],
    "related_skills": [
      "github",
      "gitlab",
      "bitbucket",
      "bash",
      "ci-cd"
    ]
  }
}
