{
  "name": "prettier",
  "description": "Complete Prettier knowledge from official documentation. Use when formatting code consistently across projects. Covers configuration, plugins, integrations, and options for all supported languages.",
  "version": "1.0.0",
  "base_url": "https://prettier.io/docs/en/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://prettier.io/docs/en/",
      "start_urls": [
        "https://prettier.io/docs/en/index.html",
        "https://prettier.io/docs/en/install.html",
        "https://prettier.io/docs/en/options.html",
        "https://prettier.io/docs/en/configuration.html"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/en/",
          "/docs/en/plugins.html"
        ],
        "exclude": [
          "/blog/"
        ]
      },
      "categories": {
        "getting_started": [
          "index",
          "install",
          "ignore"
        ],
        "configuration": [
          "configuration",
          "options",
          "cli",
          "api"
        ],
        "formatting_options": [
          "options",
          "semicolons",
          "quotes",
          "trailing-commas",
          "print-width"
        ],
        "languages": [
          "javascript",
          "typescript",
          "html",
          "css",
          "json",
          "markdown"
        ],
        "plugins": [
          "plugins",
          "plugin-api",
          "developing-plugins"
        ],
        "editors": [
          "vscode",
          "vim",
          "webstorm",
          "atom",
          "sublime"
        ],
        "ci": [
          "precommit",
          "continuous-integration"
        ],
        "integrations": [
          "eslint",
          "prettier-vscode",
          "git"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 100
    }
  ],
  "metadata": {
    "author": "Prettier Team",
    "language": "JavaScript",
    "framework_type": "Formatter",
    "use_cases": [
      "Code formatting",
      "Style consistency",
      "Team collaboration",
      "Git hooks",
      "CI/CD"
    ],
    "related_skills": [
      "eslint",
      "javascript",
      "typescript",
      "react",
      "vscode"
    ]
  }
}