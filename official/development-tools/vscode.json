{
  "name": "vscode",
  "description": "Complete Visual Studio Code knowledge from official documentation. Use when editing, debugging, and developing code. Covers extensions, debugging, tasks, settings, remote development, Copilot AI features, and the extension API.",
  "version": "1.1.0",
  "base_url": "https://code.visualstudio.com/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://code.visualstudio.com/docs/",
      "start_urls": [
        "https://code.visualstudio.com/docs",
        "https://code.visualstudio.com/docs/getstarted/introvideos",
        "https://code.visualstudio.com/docs/editor/codebasics",
        "https://code.visualstudio.com/docs/editor/debugging",
        "https://code.visualstudio.com/docs/copilot/overview",
        "https://code.visualstudio.com/docs/remote/remote-overview",
        "https://code.visualstudio.com/docs/containers/overview"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/getstarted/",
          "/docs/editor/",
          "/docs/languages/",
          "/docs/nodejs/",
          "/docs/typescript/",
          "/docs/python/",
          "/docs/copilot/",
          "/docs/remote/",
          "/docs/containers/"
        ],
        "exclude": [
          "/docs/supporting/"
        ]
      },
      "categories": {
        "getting_started": [
          "getstarted",
          "introvideos",
          "setup",
          "settings"
        ],
        "basics": [
          "codebasics",
          "editingevolved",
          "intellisense",
          "emmet"
        ],
        "debugging": [
          "debugging",
          "nodejs-debugging",
          "python-debugging",
          "debugging-configuration"
        ],
        "copilot": [
          "copilot",
          "ai-features",
          "inline-chat",
          "chat",
          "agent-mode"
        ],
        "git": [
          "versioncontrol",
          "github",
          "sourcecontrol"
        ],
        "extensions": [
          "extension-marketplace",
          "extensions",
          "your-first-extension"
        ],
        "tasks": [
          "tasks",
          "tasks-appendix",
          "task-variables"
        ],
        "terminal": [
          "integrated-terminal",
          "terminal",
          "profiles"
        ],
        "languages": [
          "languages",
          "javascript",
          "python",
          "typescript"
        ],
        "remote": [
          "remote-overview",
          "ssh",
          "wsl",
          "devcontainers"
        ],
        "snippets": [
          "userdefinedsnippets",
          "snippets",
          "snippet-syntax"
        ],
        "themes": [
          "themes",
          "color-theme",
          "file-icon-themes"
        ],
        "keybindings": [
          "keybindings",
          "custom-keybindings",
          "keybindings-json"
        ],
        "settings": [
          "settings",
          "settings-sync",
          "workspace-settings"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Microsoft",
    "language": "TypeScript",
    "framework_type": "Code Editor",
    "use_cases": [
      "Code editing",
      "Debugging",
      "Extension development",
      "Remote development",
      "Multi-language support"
    ],
    "related_skills": [
      "typescript",
      "javascript",
      "git",
      "docker",
      "python"
    ]
  }
}
