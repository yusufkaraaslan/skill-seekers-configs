          "setPosition",
          "setScale",
          "setRotation"
        ],
        "actions": [
          "Action",
          "MoveTo",
          "RotateBy",
          "ScaleTo",
          "Sequence",
          "Spawn"
        ],
        "animations": [
          "Animation",
          "Animate",
          "SpriteFrame",
          "AnimationCache"
        ],
        "physics": [
          "physics",
          "PhysicsWorld",
          "PhysicsBody",
          "PhysicsShape",
          "contact-listener"
