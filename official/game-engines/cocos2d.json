        "https://docs.cocos2d-x.org/cocos2d-x/en/",
        "https://docs.cocos2d-x.org/cocos2d-x/en/basic/index.html",
        "https://docs.cocos2d-x.org/cocos2d-x/en/physics/index.html",
        "https://docs.cocos2d-x.org/api-ref/index.html"
      ],
      "selectors": {
        "main_content": "article, main, .content",
        "title": "h1",
