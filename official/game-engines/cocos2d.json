{
  "name": "cocos2d",
  "description": "Complete Cocos2d-x knowledge from official documentation. Use when building cross-platform 2D games in C++, Lua, or JavaScript. Covers scenes, sprites, actions, physics, and particle systems.",
  "version": "1.1.0",
  "base_url": "https://docs.cocos2d-x.org/cocos2d-x/en/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.cocos2d-x.org/cocos2d-x/en/",
