          "createResource"
        ],
        "routing": [
          "routing",
          "solid-router",
          "config",
          "data"
        ],
        "server": [
          "solid-start",
          "server",
          "api-routes",
          "data-loading"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "SolidJS Team",
    "language": "TypeScript",
