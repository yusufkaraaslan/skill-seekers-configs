        "https://docs.solidjs.com/",
        "https://docs.solidjs.com/quick-start",
        "https://docs.solidjs.com/concepts/intro",
        "https://docs.solidjs.com/reference/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
