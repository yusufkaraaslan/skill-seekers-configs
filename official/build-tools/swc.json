{
  "name": "swc",
  "description": "Complete SWC knowledge from official documentation. Use when transforming JavaScript and TypeScript with Rust-based speed. Covers compilation, minification, and bundling.",
  "version": "1.1.0",
  "base_url": "https://swc.rs/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://swc.rs/docs/",
      "start_urls": [
        "https://swc.rs/docs/",
        "https://swc.rs/docs/getting-started",
        "https://swc.rs/docs/configuration/swcrc",
        "https://swc.rs/docs/configuration/compilation",
        "https://swc.rs/docs/configuration/minification",
        "https://swc.rs/docs/usage/core",
        "https://swc.rs/docs/usage/cli",
        "https://swc.rs/docs/usage/jest",
        "https://swc.rs/docs/usage/nextjs",
        "https://swc.rs/docs/plugin/ecmascript/getting-started"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/"
        ],
        "exclude": [
          "/docs/changelog"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "installation",
          "intro"
        ],
        "configuration": [
          "configuration/compilation",
          "configuration/minification",
          "configuration/swcrc",
          "jsc",
          "parser",
          "transform",
          "target",
          "minify"
        ],
        "usage": [
          "usage/core",
          "usage/cli",
          "usage/wasm",
          "usage/jest",
          "usage/nextjs"
        ],
        "cli": [
          "usage/cli",
          "compile",
          "minify"
        ],
        "jest": [
          "usage/jest",
          "jest-transform",
          "jest-config"
        ],
        "integrations": [
          "usage/nextjs",
          "usage/jest",
          "next.js",
          "webpack",
          "vite"
        ],
        "plugin": [
          "plugin/ecmascript",
          "plugin/publishing",
          "plugin/transform",
          "rust-plugin",
          "wasm-plugin"
        ],
        "typescript": [
          "configuration/compilation",
          "tsx",
          "decorators",
          "transform"
        ],
        "react": [
          "jsx",
          "tsx",
          "refresh",
          "emotion",
          "styled-components"
        ],
        "minification": [
          "configuration/minification",
          "compress",
          "mangle",
          "format"
        ],
        "migration": [
          "from-babel",
          "from-tsc"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "kdy1",
    "language": "Rust",
    "framework_type": "Compiler/Transpiler",
    "use_cases": [
      "Fast transpilation",
      "TypeScript compilation",
      "Minification",
      "Babel replacement",
      "Next.js compilation",
      "Jest transformation"
    ],
    "related_skills": [
      "javascript",
      "typescript",
      "nextjs",
      "babel",
      "jest"
    ]
  }
}
