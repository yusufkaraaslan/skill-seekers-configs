        "https://turbo.build/repo/docs/",
        "https://turbo.build/repo/docs/getting-started",
        "https://turbo.build/repo/docs/core-concepts",
        "https://turbo.build/repo/docs/reference/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
