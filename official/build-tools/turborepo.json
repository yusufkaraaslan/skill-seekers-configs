{
  "name": "turborepo",
  "description": "Complete Turborepo knowledge from official documentation. Use when building monorepos with efficient task running and caching. Covers configuration, pipelines, caching, remote caching, and filtering.",
  "version": "1.1.0",
  "base_url": "https://turbo.build/repo/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://turbo.build/repo/docs/",
      "start_urls": [
        "https://turbo.build/repo/docs/",
        "https://turbo.build/repo/docs/getting-started/installation",
        "https://turbo.build/repo/docs/crafting-your-repository/structuring-a-repository",
        "https://turbo.build/repo/docs/crafting-your-repository/configuring-tasks",
        "https://turbo.build/repo/docs/crafting-your-repository/caching",
        "https://turbo.build/repo/docs/crafting-your-repository/running-tasks",
        "https://turbo.build/repo/docs/crafting-your-repository/using-environment-variables",
        "https://turbo.build/repo/docs/core-concepts/remote-caching",
        "https://turbo.build/repo/docs/reference/configuration",
        "https://turbo.build/repo/docs/reference/turbo-prune"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/repo/docs/"
        ],
        "exclude": [
          "/repo/docs/changelog/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "installation",
          "create-new",
          "add-to-existing",
          "why-turborepo"
        ],
        "crafting_repository": [
          "structuring-a-repository",
          "managing-dependencies",
          "creating-an-internal-package",
          "configuring-tasks",
          "running-tasks"
        ],
        "tasks": [
          "configuring-tasks",
          "tasks",
          "dependsOn",
          "outputs",
          "inputs",
          "env",
          "persistent"
        ],
        "caching": [
          "caching",
          "cache-inputs",
          "cache-outputs",
          "disabling-caching",
          "force-overwrite"
        ],
        "remote_caching": [
          "remote-caching",
          "vercel",
          "self-hosted",
          "artifact-integrity"
        ],
        "environment_variables": [
          "using-environment-variables",
          "env",
          "globalEnv",
          "passThroughEnv"
        ],
        "filtering": [
          "filtering",
          "scope",
          "include-dependencies",
          "include-dependents",
          "since"
        ],
        "ci_cd": [
          "ci",
          "github-actions",
          "circleci",
          "gitlab",
          "docker",
          "pruning"
        ],
        "reference": [
          "reference/configuration",
          "command-line-reference",
          "turbo-prune",
          "turbo-run",
          "turbo-generate"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Vercel",
    "language": "Rust",
    "framework_type": "Monorepo Tool",
    "use_cases": [
      "Monorepo management",
      "Task orchestration",
      "Build caching",
      "CI/CD optimization",
      "Remote caching",
      "Incremental builds"
    ],
    "related_skills": [
      "pnpm",
      "npm",
      "yarn",
      "vercel",
      "nx"
    ]
  }
}
