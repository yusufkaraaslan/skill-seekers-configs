        ],
        "filtering": [
          "filtering",
          "scope",
          "include-dependencies",
          "include-dependents"
        ],
        "remote_caching": [
          "remote-caching",
          "vercel",
          "self-hosted"
        ],
        "handbook": [
          "handbook",
          "building-your-app",
          "developing-apps",
          "deploying"
        ],
        "reference": [
          "configuration",
          "command-line-reference",
          "api-reference"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 200
    }
  ],
  "metadata": {
    "author": "Vercel",
    "language": "Rust/Go",
