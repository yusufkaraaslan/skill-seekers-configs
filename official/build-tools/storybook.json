{
  "name": "storybook",
  "description": "Complete Storybook knowledge from official documentation. Use when developing UI components in isolation. Covers configuration, addons, testing, and documentation.",
  "version": "1.1.0",
  "base_url": "https://storybook.js.org/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://storybook.js.org/docs/",
      "start_urls": [
        "https://storybook.js.org/docs/get-started/install",
        "https://storybook.js.org/docs/get-started/whats-a-story",
        "https://storybook.js.org/docs/writing-stories",
        "https://storybook.js.org/docs/writing-docs",
        "https://storybook.js.org/docs/writing-tests",
        "https://storybook.js.org/docs/essentials/",
        "https://storybook.js.org/docs/configure/",
        "https://storybook.js.org/docs/addons/",
        "https://storybook.js.org/docs/api/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/get-started/",
          "/docs/writing-stories/",
          "/docs/writing-docs/",
          "/docs/writing-tests/",
          "/docs/essentials/",
          "/docs/addons/",
          "/docs/configure/",
          "/docs/api/"
        ],
        "exclude": [
          "/docs/changelog/",
          "/docs/migration-guide/"
        ]
      },
      "categories": {
        "getting_started": [
          "install",
          "whats-a-story",
          "setup",
          "first-component"
        ],
        "writing_stories": [
          "stories",
          "args",
          "parameters",
          "decorators",
          "play-function",
          "loaders",
          "naming-components"
        ],
        "writing_docs": [
          "autodocs",
          "mdx",
          "doc-blocks",
          "documentation"
        ],
        "writing_tests": [
          "interaction-testing",
          "visual-testing",
          "accessibility-testing",
          "test-runner",
          "coverage"
        ],
        "essentials": [
          "actions",
          "backgrounds",
          "controls",
          "docs",
          "viewport",
          "toolbars",
          "highlight"
        ],
        "addons": [
          "addons",
          "writing-addons",
          "addon-catalog",
          "preset"
        ],
        "configure": [
          "overview",
          "story-rendering",
          "typescript",
          "styling",
          "environment-variables",
          "babel"
        ],
        "frameworks": [
          "react",
          "vue",
          "angular",
          "svelte",
          "nextjs",
          "nuxt",
          "sveltekit"
        ],
        "api": [
          "arg-types",
          "parameters",
          "csf",
          "story-index"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Storybook",
    "language": "JavaScript/TypeScript",
    "framework_type": "Development Tool",
    "use_cases": [
      "Component development",
      "UI documentation",
      "Visual testing",
      "Interaction testing",
      "Design systems",
      "Accessibility testing"
    ],
    "related_skills": [
      "react",
      "vue",
      "angular",
      "svelte",
      "chromatic",
      "vitest"
    ]
  }
}
