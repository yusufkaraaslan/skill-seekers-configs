          "metered"
        ],
        "customers": [
          "customers",
          "setup-intents",
          "saved-cards"
        ],
        "connect": [
          "connect",
          "marketplaces",
          "platforms",
          "express",
          "custom"
        ],
        "webhooks": [
          "webhooks",
          "signatures",
          "events",
          "listen"
        ],
        "testing": [
          "testing",
          "test-cards",
          "test-clocks"
        ],
        "security": [
          "security",
          "pci",
          "3d-secure",
          "sca"
        ]
