{
  "name": "kubernetes",
  "description": "Complete Kubernetes orchestration knowledge combining official documentation and Kubernetes codebase. Use when deploying, managing, or debugging Kubernetes clusters and workloads.",
  "version": "1.1.0",
  "merge_mode": "rule-based",
  "base_url": "https://kubernetes.io/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://kubernetes.io/docs/",
      "extract_api": true,
      "start_urls": [
        "https://kubernetes.io/docs/concepts/",
        "https://kubernetes.io/docs/tasks/",
        "https://kubernetes.io/docs/reference/kubectl/",
        "https://kubernetes.io/docs/setup/",
        "https://kubernetes.io/docs/tutorials/"
      ],
      "selectors": {
        "main_content": "article",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [
          "/docs/concepts/",
          "/docs/tasks/",
          "/docs/reference/",
          "/docs/setup/",
          "/docs/tutorials/"
        ],
        "exclude": [
          "/blog/",
          "/case-studies/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "overview",
          "introduction",
          "setup"
        ],
        "concepts": [
          "concepts",
          "architecture",
          "cluster"
        ],
        "workloads": [
          "workloads",
          "pods",
          "deployments",
          "statefulsets",
          "daemonsets",
          "jobs",
          "cronjobs"
        ],
        "services": [
          "services",
          "networking",
          "ingress",
          "dns"
        ],
        "storage": [
          "storage",
          "volumes",
          "persistent",
          "pvc",
          "storageclass"
        ],
        "configuration": [
          "configmap",
          "secrets",
          "configuration"
        ],
        "scheduling": [
          "scheduling",
          "affinity",
          "taints",
          "tolerations",
          "resource-limits"
        ],
        "security": [
          "security",
          "rbac",
          "authentication",
          "authorization",
          "network-policy"
        ],
        "api": [
          "api",
          "reference",
          "kubectl"
        ]
      },
      "rate_limit": 0.5
    },
    {
      "type": "github",
      "repo": "kubernetes/kubernetes",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": true,
      "max_issues": 100,
      "fetch_changelog": true,
      "fetch_releases": true,
      "file_patterns": [
        "pkg/apis/**/*.go",
        "pkg/controller/**/*.go",
        "pkg/kubelet/**/*.go",
        "staging/src/k8s.io/api/**/*.go",
        "staging/src/k8s.io/client-go/**/*.go"
      ]
    }
  ],
  "metadata": {
    "author": "Cloud Native Computing Foundation",
    "language": "Go",
    "framework_type": "Container Orchestration",
    "use_cases": [
      "Container orchestration",
      "Microservices deployment",
      "Auto-scaling",
      "Service discovery",
      "Rolling deployments"
    ],
    "related_skills": [
      "docker",
      "helm",
      "terraform",
      "prometheus",
      "istio"
    ]
  }
}
