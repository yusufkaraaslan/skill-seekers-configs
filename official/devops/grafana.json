{
  "name": "grafana",
  "description": "Complete Grafana knowledge from official documentation. Use when visualizing metrics, logs, and creating dashboards. Covers data sources, panels, alerting, and Grafana Cloud.",
  "version": "1.0.0",
  "base_url": "https://grafana.com/docs/grafana/latest/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://grafana.com/docs/grafana/latest/",
      "start_urls": [
        "https://grafana.com/docs/grafana/latest/getting-started/",
        "https://grafana.com/docs/grafana/latest/dashboards/",
        "https://grafana.com/docs/grafana/latest/datasources/",
        "https://grafana.com/docs/grafana/latest/alerting/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/grafana/latest/getting-started/",
          "/docs/grafana/latest/dashboards/",
          "/docs/grafana/latest/datasources/",
          "/docs/grafana/latest/panels/",
          "/docs/grafana/latest/alerting/",
          "/docs/grafana/latest/setup-grafana/"
        ],
        "exclude": [
          "/docs/grafana/latest/release-notes/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "installation",
          "docker",
          "configuration"
        ],
        "datasources": [
          "datasources",
          "prometheus",
          "influxdb",
          "elasticsearch",
          "mysql",
          "postgres"
        ],
        "dashboards": [
          "dashboards",
          "create",
          "manage",
          "json-model",
          "variables"
        ],
        "panels": [
          "panels",
          "visualizations",
          "queries",
          "transformations",
          "overrides"
        ],
        "alerting": [
          "alerting",
          "alert-rules",
          "notification-channels",
          "silences"
        ],
        "explore": [
          "explore",
          "logs",
          "traces",
          "correlation"
        ],
        "plugins": [
          "plugins",
          "panel-plugins",
          "datasource-plugins",
          "app-plugins"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Grafana Labs",
    "language": "Go/TypeScript",
    "framework_type": "Visualization",
    "use_cases": [
      "Metrics visualization",
      "Dashboard creation",
      "Log analysis",
      "Alerting",
      "Observability"
    ],
    "related_skills": [
      "prometheus",
      "elasticsearch",
      "influxdb",
      "loki",
      "tempo"
    ]
  }
}
