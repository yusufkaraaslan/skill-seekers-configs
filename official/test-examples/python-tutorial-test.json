{
  "name": "python-tutorial-test",
  "description": "\u26a0\ufe0f TEST CONFIG - Python tutorial for testing MCP tools and quick validation. Limited to 10 pages. Not for production use.",
  "version": "1.0.0",
  "base_url": "https://docs.python.org/3/tutorial/",
  "sources": [
    {
