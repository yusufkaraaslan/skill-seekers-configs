          "introduction",
          "basic",
          "getting-started"
        ],
        "control_flow": [
          "control",
          "if",
          "for",
          "while"
        ],
        "data_structures": [
          "list",
          "dict",
          "tuple",
          "set"
        ],
        "functions": [
          "function",
          "def",
          "lambda"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 10
    }
  ]
}