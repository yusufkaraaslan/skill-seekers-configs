      "base_url": "https://docs.python.org/3/tutorial/",
      "start_urls": [
        "https://docs.python.org/3/tutorial/introduction.html",
        "https://docs.python.org/3/tutorial/controlflow.html"
      ],
      "selectors": {
        "main_content": "article",
