{
  "name": "template-example",
  "description": "\u26a0\ufe0f TEMPLATE CONFIG - NOT FOR PRODUCTION USE. Copy and modify this template for your own documentation site. Replace URLs, selectors, and categories with your specific requirements.",
  "version": "1.0.0",
  "base_url": "https://YOUR-DOCS-SITE.com/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://YOUR-DOCS-SITE.com/",
      "start_urls": [
        "https://YOUR-DOCS-SITE.com/getting-started",
        "https://YOUR-DOCS-SITE.com/api"
      ],
      "selectors": {
        "main_content": "article",
        "title": "h1",
        "code_blocks": "pre code"
      },
      "url_patterns": {
        "include": [
          "/docs/",
          "/guide/"
        ],
        "exclude": [
          "/blog/",
          "/search/",
          "/_static/"
        ]
      },
      "categories": {
        "getting_started": [
          "introduction",
          "getting-started",
          "quick",
          "setup"
        ],
        "core_concepts": [
          "concept",
          "fundamental",
          "architecture"
        ],
        "api_reference": [
          "api",
          "reference",
          "method",
          "function"
        ],
        "examples": [
          "example",
          "tutorial",
          "guide",
          "walkthrough"
        ]
      },
      "rate_limit": 0.5
    }
  ]
}
