          "next-js",
          "vite",
          "remix",
          "migration"
        ],
        "styling": [
          "styling",
          "overview",
          "style-props",
          "responsive-design",
          "conditional-styles",
          "css",
          "keyframes"
        ],
        "theming": [
          "theming",
          "overview",
          "tokens",
          "semantic-tokens",
          "recipes",
          "slot-recipes",
          "dark-mode"
        ],
        "components": [
          "button",
          "input",
          "select",
          "dialog",
          "drawer",
          "card",
          "table",
          "badge",
          "avatar",
          "checkbox",
          "radio",
          "switch",
          "slider",
          "toast"
        ],
        "layout": [
          "box",
          "stack",
          "flex",
          "grid",
          "container",
          "center",
          "spacer",
          "separator"
        ],
        "overlay": [
          "dialog",
          "drawer",
          "popover",
          "tooltip",
          "menu",
          "context-menu"
        ],
        "forms": [
          "field",
          "input",
          "textarea",
          "select",
          "checkbox",
          "radio",
          "number-input",
          "pin-input"
        ],
        "hooks": [
          "use-color-mode",
          "use-theme",
          "use-disclosure",
          "use-toast",
          "use-clipboard"
        ],
        "accessibility": [
          "accessibility",
          "aria",
          "keyboard",
          "focus"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Chakra UI Team",
    "language": "TypeScript",
    "framework_type": "UI Library",
    "use_cases": [
      "React applications",
