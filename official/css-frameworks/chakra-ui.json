{
  "name": "chakra-ui",
  "description": "Complete Chakra UI v3 knowledge from official documentation. Use when building accessible React applications with composable, themeable components. Covers the new recipe-based theming system, styling props, component library, and composition patterns.",
  "version": "1.1.0",
  "base_url": "https://www.chakra-ui.com/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://www.chakra-ui.com/docs/",
      "start_urls": [
        "https://www.chakra-ui.com/docs/get-started/installation",
        "https://www.chakra-ui.com/docs/get-started/frameworks/next-js",
        "https://www.chakra-ui.com/docs/get-started/frameworks/vite",
        "https://www.chakra-ui.com/docs/styling/overview",
        "https://www.chakra-ui.com/docs/theming/overview",
        "https://www.chakra-ui.com/docs/components",
        "https://www.chakra-ui.com/docs/components/button",
        "https://www.chakra-ui.com/docs/components/input",
        "https://www.chakra-ui.com/docs/components/dialog",
        "https://www.chakra-ui.com/docs/components/select"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
