{
  "name": "bulma",
  "description": "Complete Bulma knowledge from official documentation. Use when building responsive web interfaces with a modern CSS framework. Covers grid, components, elements, and modifiers.",
  "version": "1.0.0",
  "base_url": "https://bulma.io/documentation/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://bulma.io/documentation/",
      "start_urls": [
        "https://bulma.io/documentation/",
        "https://bulma.io/documentation/overview/",
        "https://bulma.io/documentation/columns/",
        "https://bulma.io/documentation/elements/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/documentation/overview/",
          "/documentation/columns/",
          "/documentation/layout/",
          "/documentation/form/",
          "/documentation/elements/",
          "/documentation/components/"
        ],
        "exclude": [
          "/blog/"
        ]
      },
      "categories": {
        "getting_started": [
          "",
          "overview/start",
          "overview/installation",
          "overview/classes"
        ],
        "customize": [
          "overview/customize",
          "sass",
          "variables",
          "modifiers"
        ],
        "columns": [
          "columns/basics",
          "columns/sizes",
          "columns/responsiveness",
          "columns/gap",
          "columns/options"
        ],
        "layout": [
          "layout/container",
          "layout/level",
          "layout/media-object",
          "layout/hero",
          "layout/section",
          "layout/footer",
          "layout/tiles"
        ],
        "form": [
          "form/general",
          "form/input",
          "form/textarea",
          "form/select",
          "form/checkbox",
          "form/radio",
          "form/file"
        ],
        "elements": [
          "elements/box",
          "elements/button",
          "elements/content",
          "elements/delete",
          "elements/icon",
          "elements/image",
          "elements/notification",
          "elements/progress",
          "elements/table",
          "elements/tag",
          "elements/title"
        ],
        "components": [
          "components/breadcrumb",
          "components/card",
          "components/dropdown",
          "components/menu",
          "components/message",
          "components/modal",
          "components/navbar",
          "components/pagination",
          "components/panel",
          "components/tabs"
        ],
        "helpers": [
          "helpers/color-helpers",
          "helpers/spacing-helpers",
          "helpers/typography-helpers",
          "helpers/visibility-helpers",
          "helpers/flexbox-helpers"
        ],
        "modifiers": [
          "modifiers/syntax",
          "modifiers/helpers",
          "modifiers/responsive-helpers",
          "modifiers/color-helpers"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 300
    }
  ],
  "metadata": {
    "author": "Jeremy Thomas",
    "language": "CSS/Sass",
    "framework_type": "CSS Framework",
    "use_cases": [
      "Responsive design",
      "Rapid prototyping",
      "Modern interfaces",
      "CSS-only",
      "No JavaScript"
    ],
    "related_skills": [
      "html",
      "css",
      "sass",
      "responsive-design",
      "javascript"
    ]
  }
}