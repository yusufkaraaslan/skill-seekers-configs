{
  "name": "bulma",
  "description": "Complete Bulma knowledge from official documentation. Use when building responsive web interfaces with a modern CSS-only framework. Covers the grid system, layout, elements, components, form controls, helpers, and Bulma v1 CSS variables with dark mode support.",
  "version": "1.1.0",
  "base_url": "https://bulma.io/documentation/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://bulma.io/documentation/",
      "start_urls": [
        "https://bulma.io/documentation/",
        "https://bulma.io/documentation/overview/",
        "https://bulma.io/documentation/columns/",
        "https://bulma.io/documentation/layout/",
        "https://bulma.io/documentation/form/",
        "https://bulma.io/documentation/elements/",
        "https://bulma.io/documentation/components/",
        "https://bulma.io/documentation/helpers/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
