{
  "name": "mui-material",
  "description": "Complete MUI Material UI knowledge from official documentation. Use when building React applications with Material Design components. Covers all components, theming, the sx prop, system utilities, icons, and the Data Grid.",
  "version": "1.1.0",
  "base_url": "https://mui.com/material-ui/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://mui.com/material-ui/",
      "start_urls": [
        "https://mui.com/material-ui/getting-started/",
        "https://mui.com/material-ui/react-button/",
        "https://mui.com/material-ui/react-text-field/",
