        "https://docs.sentry.io/",
        "https://docs.sentry.io/platforms/",
        "https://docs.sentry.io/product/",
        "https://docs.sentry.io/api/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/platforms/",
          "/product/",
          "/api/",
          "/concepts/",
          "/cli/"
        ],
        "exclude": [
          "/changelog/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "install",
          "configure",
          "verify"
        ],
        "platforms": [
          "javascript",
          "python",
          "node",
          "react",
          "vue",
          "nextjs"
        ],
        "error_tracking": [
          "errors",
          "capturing",
          "scopes",
          "context",
          "breadcrumbs"
        ],
        "performance": [
          "performance",
          "instrumentation",
          "distributed-tracing",
          "queries",
          "web-vitals"
        ],
        "releases": [
          "releases",
          "source-maps",
          "suspect-commits",
          "release-health"
        ],
        "configuration": [
          "options",
          "environments",
          "sampling",
          "filtering"
        ],
        "integrations": [
          "integrations",
          "github",
          "slack",
          "jira",
          "vercel"
        ],
        "api": [
          "api",
          "auth",
          "pagination",
          "rate-limits"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Sentry",
    "language": "Multi-language",
    "framework_type": "Error Monitoring",
    "use_cases": [
      "Error tracking",
