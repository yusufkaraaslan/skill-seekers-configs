{
  "name": "sentry",
  "description": "Complete Sentry knowledge from official documentation. Use when monitoring application errors and performance. Covers error tracking, performance monitoring, release health, and distributed tracing.",
  "version": "1.1.0",
  "base_url": "https://docs.sentry.io/",
