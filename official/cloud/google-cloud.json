{
  "name": "google-cloud",
  "description": "Complete Google Cloud Platform knowledge from official documentation. Use when building applications on GCP. Covers Compute Engine, Cloud Run, GKE, Cloud Storage, BigQuery, Cloud SQL, Pub/Sub, IAM, and Cloud Build.",
  "version": "1.1.0",
  "base_url": "https://cloud.google.com/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://cloud.google.com/",
      "start_urls": [
        "https://cloud.google.com/getting-started",
        "https://cloud.google.com/compute/docs",
        "https://cloud.google.com/run/docs",
        "https://cloud.google.com/kubernetes-engine/docs",
        "https://cloud.google.com/functions/docs",
        "https://cloud.google.com/storage/docs",
        "https://cloud.google.com/bigquery/docs",
        "https://cloud.google.com/sql/docs",
        "https://cloud.google.com/pubsub/docs",
        "https://cloud.google.com/iam/docs",
        "https://cloud.google.com/secret-manager/docs",
        "https://cloud.google.com/build/docs",
        "https://cloud.google.com/monitoring/docs",
        "https://cloud.google.com/logging/docs",
        "https://cloud.google.com/vertex-ai/docs"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/getting-started",
          "/compute/docs/",
          "/run/docs/",
          "/kubernetes-engine/docs/",
          "/functions/docs/",
          "/storage/docs/",
          "/bigquery/docs/",
          "/sql/docs/",
          "/pubsub/docs/",
          "/iam/docs/",
          "/secret-manager/docs/",
          "/build/docs/",
          "/monitoring/docs/",
          "/logging/docs/",
          "/vertex-ai/docs/"
        ],
        "exclude": [
          "/release-notes/",
          "/blog/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "setup",
          "billing",
          "free-tier"
        ],
        "compute": [
          "compute-engine",
          "cloud-run",
          "app-engine",
          "gke",
          "kubernetes-engine",
          "cloud-functions"
        ],
        "storage": [
          "cloud-storage",
          "persistent-disk",
          "filestore",
          "backup"
        ],
        "database": [
          "cloud-sql",
          "firestore",
          "bigtable",
          "spanner",
          "memorystore"
        ],
        "analytics": [
          "bigquery",
          "dataflow",
          "dataproc",
          "pubsub"
        ],
        "networking": [
          "vpc",
          "load-balancing",
          "cloud-cdn",
          "cloud-dns"
        ],
        "security": [
          "iam",
          "kms",
          "secret-manager",
          "cloud-armor"
        ],
        "devtools": [
          "cloud-build",
          "cloud-source",
          "cloud-deploy",
          "artifact-registry"
        ],
        "monitoring": [
          "monitoring",
          "logging",
          "cloud-trace",
          "error-reporting"
        ],
        "ai_ml": [
          "vertex-ai",
          "vision",
          "natural-language",
          "speech",
          "translation"
        ]
      },
      "rate_limit": 0.5
    }
  ],
  "metadata": {
    "author": "Google",
    "language": "Multi-language",
    "framework_type": "Cloud Platform",
    "use_cases": [
      "Cloud infrastructure",
      "Data analytics",
      "Machine learning",
      "Serverless apps",
      "Enterprise migration"
