{
  "name": "aws-boto3",
  "description": "Complete AWS Boto3 knowledge from official documentation. Use when building Python applications that interact with AWS services. Covers S3, EC2, Lambda, DynamoDB, and 200+ AWS services.",
  "version": "1.0.0",
  "base_url": "https://boto3.amazonaws.com/v1/documentation/api/latest/index.html",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://boto3.amazonaws.com/v1/documentation/api/latest/index.html",
