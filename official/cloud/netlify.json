{
  "name": "netlify",
  "description": "Complete Netlify knowledge from official documentation. Use when deploying web applications with CI/CD, serverless functions, edge functions, and global CDN. Covers builds, deploys, functions, forms, identity, blob storage, and CLI.",
  "version": "1.1.0",
  "base_url": "https://docs.netlify.com/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.netlify.com/",
      "start_urls": [
        "https://docs.netlify.com/get-started/",
        "https://docs.netlify.com/configure-builds/",
        "https://docs.netlify.com/functions/",
        "https://docs.netlify.com/edge-functions/",
        "https://docs.netlify.com/blobs/",
        "https://docs.netlify.com/routing/",
        "https://docs.netlify.com/forms/",
        "https://docs.netlify.com/identity/",
        "https://docs.netlify.com/cli/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/get-started/",
          "/configure-builds/",
          "/functions/",
          "/edge-functions/",
          "/blobs/",
          "/routing/",
          "/forms/",
          "/identity/",
          "/cli/"
        ],
        "exclude": [
          "/changelog/"
        ]
      },
      "categories": {
        "getting_started": [
          "get-started",
          "deploy-button",
          "site-dashboard"
        ],
        "builds": [
          "configure-builds",
          "build-settings",
          "environment-variables",
          "monorepos",
          "dependency-caching"
        ],
        "deploys": [
          "deploys",
          "deploy-previews",
          "branch-deploys",
          "build-hooks",
          "rollbacks"
        ],
        "functions": [
          "functions",
          "overview",
          "build-with-javascript",
          "build-with-typescript",
          "build-with-go"
        ],
        "edge_functions": [
          "edge-functions",
          "create-edge-function",
          "edge-function-API"
        ],
        "blobs": [
          "blobs",
          "blob-storage",
          "get-set",
          "list"
        ],
        "routing": [
          "routing",
          "redirects",
          "rewrites",
          "proxies",
          "custom-headers"
        ],
        "forms": [
          "forms",
          "setup",
          "submissions",
          "notifications"
        ],
        "identity": [
          "identity",
          "add-to-site",
          "identity-provider",
          "access-control"
        ],
        "configuration": [
          "file-based-configuration",
          "netlify-toml",
          "headers",
          "environment-variables"
        ],
        "cli": [
          "cli",
          "install",
          "deploy",
          "dev",
          "env"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Netlify",
    "language": "Multi-language",
    "framework_type": "Cloud Platform",
    "use_cases": [
      "Static site hosting",
      "Serverless functions",
      "Edge computing",
      "Form handling",
      "CI/CD"
    ],
    "related_skills": [
      "gatsby",
      "nextjs",
      "hugo",
      "jekyll",
      "astro"
    ]
