          "http-methods",
          "authorization"
        ],
        "collections": [
          "collections/collections-overview",
          "creating-collections",
          "sharing-collections",
          "collection-templates"
        ],
        "environments": [
          "environments/environment-basics",
          "variables",
          "environment-quick-start",
          "globals"
        ],
        "scripts": [
          "writing-scripts/intro-to-scripts",
          "pre-request-scripts",
          "tests",
          "script-reference"
        ],
        "test_scripts": [
          "writing-scripts/test-scripts",
          "assertions",
          "pm-test",
          "response-validation"
        ],
        "api_testing": [
          "writing-scripts/script-references/test-examples",
          "automated-testing",
          "ci-cd"
        ],
        "newman": [
          "running-collections/using-newman-cli",
          "newman-with-docker",
          "continuous-integration"
        ],
        "monitors": [
          "monitoring-your-api/intro-monitors",
