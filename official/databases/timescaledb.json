          "hypertables",
          "create",
          "insert",
          "query",
          "partitioning"
        ],
        "continuous_aggregates": [
          "continuous-aggregates",
          "create",
          "refresh",
          "real-time"
        ],
        "compression": [
          "compression",
          "columnar",
          "decompress",
          "settings"
        ],
        "retention": [
          "retention",
          "drop-chunks",
          "policies"
        ],
        "data_tiering": [
          "data-tiering",
          "tiered-storage",
          "move-chunks",
          "object-storage"
        ],
        "actions": [
          "user-defined-actions",
          "automation",
          "policies",
          "jobs",
          "background-workers"
        ],
        "querying": [
          "querying",
          "time-bucket",
          "gapfilling",
