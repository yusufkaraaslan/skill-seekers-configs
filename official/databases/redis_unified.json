{
  "name": "redis",
  "description": "Complete Redis knowledge combining documentation and source code. Use when implementing caching, message queues, real-time features, session storage, or vector search. Covers data structures, persistence, clustering, Redis Stack, and vector search.",
  "version": "1.1.0",
  "merge_mode": "rule-based",
  "base_url": "https://redis.io/docs/latest/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://redis.io/docs/latest/",
      "extract_api": true,
      "start_urls": [
        "https://redis.io/docs/latest/",
        "https://redis.io/docs/latest/get-started/",
        "https://redis.io/docs/latest/develop/data-types/",
        "https://redis.io/docs/latest/operate/",
        "https://redis.io/docs/latest/commands/",
        "https://redis.io/docs/latest/develop/",
        "https://redis.io/docs/latest/integrate/",
        "https://redis.io/docs/latest/develop/ai/"
      ],
      "selectors": {
        "main_content": "article, main, .docs-content",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/latest/",
          "/commands/"
        ],
        "exclude": [
          "/blog/",
          "/resources/",
          "/partners/"
        ]
      },
      "categories": {
        "getting_started": [
          "getting-started",
          "get-started",
          "installation",
          "quick-start",
          "introduction"
        ],
        "data_structures": [
          "strings",
          "lists",
          "sets",
          "sorted-sets",
          "hashes",
          "streams",
          "geospatial",
          "bitmap",
          "hyperloglog"
        ],
        "commands": [
          "commands",
          "get",
          "set",
          "del",
          "expire",
          "ttl"
        ],
        "persistence": [
          "persistence",
          "rdb",
          "aof",
          "snapshot",
          "appendonly"
        ],
        "clustering": [
          "cluster",
          "replication",
          "sentinel",
          "sharding",
          "failover"
        ],
        "caching": [
          "caching",
          "cache",
          "eviction",
          "maxmemory",
          "lru",
          "lfu"
        ],
        "messaging": [
          "pubsub",
          "streams",
          "consumer-group",
          "queue"
        ],
        "redis_stack": [
          "search",
          "json",
          "timeseries",
          "bloom"
        ],
        "vector": [
          "vector",
          "vector-search",
          "embeddings",
          "semantic-search",
          "ai",
          "knn"
        ],
        "security": [
          "security",
          "acl",
          "tls",
          "auth",
          "encryption"
        ]
      },
      "rate_limit": 0.3
    },
    {
      "type": "github",
      "repo": "redis/redis",
      "enable_codebase_analysis": true,
      "code_analysis_depth": "deep",
      "fetch_issues": true,
      "max_issues": 100,
      "fetch_changelog": true,
      "fetch_releases": true,
      "file_patterns": [
        "src/*.c",
        "src/*.h"
      ]
    }
  ],
  "metadata": {
    "author": "Redis Ltd.",
    "language": "C",
    "framework_type": "In-Memory Data Store",
    "use_cases": [
      "Caching layer",
      "Session storage",
      "Real-time analytics",
      "Message broker",
      "Rate limiting",
      "Leaderboards"
    ],
    "related_skills": [
      "postgresql",
      "mongodb",
      "nodejs",
      "python",
      "docker"
    ]
  }
}
