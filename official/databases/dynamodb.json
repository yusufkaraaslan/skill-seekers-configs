{
  "name": "dynamodb",
  "description": "Complete Amazon DynamoDB knowledge from official documentation. Use when building serverless, NoSQL applications at any scale. Covers data modeling, streams, DAX, and global tables.",
  "version": "1.0.0",
  "base_url": "https://docs.aws.amazon.com/dynamodb/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.aws.amazon.com/dynamodb/",
