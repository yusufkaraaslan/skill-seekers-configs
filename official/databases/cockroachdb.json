          "sql-statements",
          "selection-queries",
          "table-expressions",
          "scalar-expressions"
        ],
        "data_types": [
          "data-types",
          "int",
          "float",
          "decimal",
          "string",
          "bytes",
          "timestamp",
          "uuid",
          "jsonb"
        ],
        "transactions": [
          "transactions",
          "isolation-levels",
          "savepoints",
          "retries"
        ],
        "architecture": [
          "architecture/overview",
          "architecture/distribution-layer",
          "architecture/replication-layer",
          "architecture/storage-layer"
        ],
        "multi_region": [
          "multiregion-overview",
          "region-survival-goals",
          "table-localities",
          "regional-tables",
          "global-tables"
        ],
        "performance": [
          "performance",
          "cost-based-optimizer",
