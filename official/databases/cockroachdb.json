          "inverted-indexes",
          "partitioning"
        ],
        "security": [
          "security-reference",
          "authentication",
          "authorization",
          "ssl-modes",
          "encryption"
        ],
        "backup_restore": [
          "backup-and-restore",
          "full-backups",
          "incremental-backups",
          "point-in-time-recovery"
        ],
        "cluster_management": [
          "cockroach-commands",
          "cockroach-start",
          "cockroach-init",
          "cockroach-sql"
        ],
        "changefeeds": [
          "change-data-capture",
          "create-changefeed",
          "changefeed-sinks",
          "kafka"
        ]
      },
      "rate_limit": 0.3
    }
  ],
  "metadata": {
    "author": "Cockroach Labs",
    "language": "SQL",
