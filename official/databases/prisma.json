{
  "name": "prisma",
  "description": "Complete Prisma knowledge from official documentation. Use when building type-safe database applications with Node.js and TypeScript. Covers Prisma ORM schema definition, client queries, migrations, relations, and Prisma Accelerate.",
  "version": "1.1.0",
  "base_url": "https://www.prisma.io/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://www.prisma.io/docs/",
      "start_urls": [
        "https://www.prisma.io/docs/getting-started",
        "https://www.prisma.io/docs/orm/overview/",
        "https://www.prisma.io/docs/orm/prisma-schema/",
        "https://www.prisma.io/docs/orm/prisma-client/",
        "https://www.prisma.io/docs/orm/prisma-migrate/",
        "https://www.prisma.io/docs/orm/reference/",
        "https://www.prisma.io/docs/accelerate/",
        "https://www.prisma.io/docs/guides/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/docs/getting-started",
          "/docs/orm/",
          "/docs/accelerate/",
          "/docs/guides/"
