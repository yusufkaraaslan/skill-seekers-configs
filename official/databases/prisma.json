        ]
      },
      "categories": {
        "getting_started": [
          "quickstart",
          "setup-prisma",
          "add-to-existing-project"
        ],
        "schema": [
          "prisma-schema",
          "models",
          "fields",
          "relations",
          "enums"
        ],
        "client": [
          "prisma-client",
          "crud",
          "reading-data",
          "writing-data",
          "transactions"
        ],
        "relations": [
          "relations",
          "one-to-one",
          "one-to-many",
          "many-to-many",
          "self-relations"
        ],
        "migrations": [
          "prisma-migrate",
          "create-migrations",
          "seed-database",
          "production"
        ],
        "queries": [
          "select-fields",
          "filtering",
          "sorting",
          "pagination",
          "aggregation"
        ],
        "advanced": [
          "raw-queries",
          "middleware",
          "connection-management",
          "logging"
        ],
        "accelerate": [
          "accelerate",
          "connection-pooling",
          "global-database",
          "caching"
        ]
      },
