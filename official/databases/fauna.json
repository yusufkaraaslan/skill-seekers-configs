        "https://docs.fauna.com/fauna/current/",
        "https://docs.fauna.com/fauna/current/learn/",
        "https://docs.fauna.com/fauna/current/fql/",
        "https://docs.fauna.com/fauna/current/cookbook/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/fauna/current/learn/",
          "/fauna/current/fql/",
          "/fauna/current/cookbook/",
          "/fauna/current/drivers/"
        ],
        "exclude": [
          "/fauna/current/release_notes/"
        ]
      },
