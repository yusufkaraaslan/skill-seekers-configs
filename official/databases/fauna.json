{
  "name": "fauna",
  "description": "Complete Fauna knowledge from official documentation. Use when building serverless applications with a distributed document-relational database. Covers FQL, GraphQL, and ACID transactions.",
  "version": "1.0.0",
  "base_url": "https://docs.fauna.com/fauna/current/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.fauna.com/fauna/current/",
