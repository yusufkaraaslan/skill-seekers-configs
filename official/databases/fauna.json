          "",
          "learn/quick_start",
          "learn/installation",
          "dashboard"
        ],
        "fql_basics": [
          "fql/basics",
          "values",
          "collections",
          "documents",
          "indexes"
        ],
        "fql_queries": [
          "fql/queries",
          "let",
          "map",
          "filter",
          "reduce"
        ],
        "fql_functions": [
          "fql/functions",
          "user-defined-functions",
          "udfs",
          "lambda"
        ],
        "data_modeling": [
          "learn/data_modeling",
          "collections",
          "indexes",
          "relationships",
          "normalization"
        ],
        "authentication": [
          "learn/security",
          "access-providers",
          "keys",
          "tokens",
          "roles"
        ],
        "graphql": [
          "learn/graphql",
          "schema",
          "resolvers",
          "@embedded"
        ],
        "transactions": [
          "fql/transactions",
          "acid",
          "serializable",
          "occ"
        ],
        "temporal": [
          "fql/temporal",
          "at",
          "snapshot",
