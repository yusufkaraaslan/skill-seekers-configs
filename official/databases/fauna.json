        "cookbook": [
          "cookbook/",
          "crud",
          "relationships",
          "authentication",
          "pagination"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 300
    }
  ],
  "metadata": {
    "author": "Fauna",
    "language": "FQL/GraphQL",
    "framework_type": "Serverless Database",
    "use_cases": [
      "Serverless apps",
      "Jamstack",
      "Real-time apps",
      "Multi-tenant SaaS",
