{
  "name": "sqlite",
  "description": "Complete SQLite knowledge from official documentation. Use when building embedded, serverless databases for applications. Covers SQL, full-text search (FTS5), R*Trees, JSON functions, WAL mode, and the C API.",
  "version": "1.1.0",
  "base_url": "https://www.sqlite.org/",
  "sources": [
