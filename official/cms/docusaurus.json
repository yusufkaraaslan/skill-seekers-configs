{
  "name": "docusaurus",
  "description": "Complete Docusaurus knowledge from official documentation. Use when building documentation websites with Markdown, MDX, and React. Covers configuration, theming, plugins, versioning, i18n, search, and deployment.",
  "version": "1.1.0",
  "base_url": "https://docusaurus.io/docs/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docusaurus.io/docs/",
      "start_urls": [
        "https://docusaurus.io/docs/",
        "https://docusaurus.io/docs/installation",
        "https://docusaurus.io/docs/configuration",
        "https://docusaurus.io/docs/markdown-features",
        "https://docusaurus.io/docs/styling-layout",
        "https://docusaurus.io/docs/swizzling",
        "https://docusaurus.io/docs/deployment",
        "https://docusaurus.io/docs/i18n/introduction",
        "https://docusaurus.io/docs/versioning",
        "https://docusaurus.io/docs/search",
        "https://docusaurus.io/docs/cli",
        "https://docusaurus.io/docs/api/docusaurus-config",
        "https://docusaurus.io/docs/advanced/"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
