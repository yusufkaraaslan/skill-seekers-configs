          "swizzling",
          "custom-css",
          "color-mode"
        ],
        "plugins": [
          "plugins",
          "plugin-content-docs",
          "plugin-content-blog",
          "plugin-pwa",
          "plugin-sitemap",
          "plugin-google-analytics"
        ],
        "themes": [
          "themes",
          "classic",
          "swizzling",
          "navbar",
          "footer"
        ],
        "api": [
          "api",
          "docusaurus-config",
