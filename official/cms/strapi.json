        "https://docs.strapi.io/dev-docs/database",
        "https://docs.strapi.io/dev-docs/plugins/developing-plugins",
        "https://docs.strapi.io/dev-docs/deployment",
        "https://docs.strapi.io/user-docs/intro",
        "https://docs.strapi.io/cloud/intro"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
