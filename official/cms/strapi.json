{
  "name": "strapi",
  "description": "Complete Strapi knowledge from official documentation. Use when building headless CMS APIs with a customizable admin panel. Covers content types, REST and GraphQL APIs, authentication, plugins, TypeScript, and deployment.",
  "version": "1.1.0",
  "base_url": "https://docs.strapi.io/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://docs.strapi.io/",
      "start_urls": [
        "https://docs.strapi.io/dev-docs/intro",
        "https://docs.strapi.io/dev-docs/quick-start",
        "https://docs.strapi.io/dev-docs/installation",
        "https://docs.strapi.io/dev-docs/api/rest",
        "https://docs.strapi.io/dev-docs/api/graphql",
        "https://docs.strapi.io/dev-docs/backend-customization",
