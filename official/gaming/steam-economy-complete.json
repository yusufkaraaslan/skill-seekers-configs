        ],
        "examples": [
          "example",
          "sample",
          "tutorial",
          "walkthrough"
        ]
      },
      "rate_limit": 0.7
    }
  ],
  "metadata": {
    "author": "Valve Corporation",
    "language": "C++/Web API",
    "framework_type": "Game Platform SDK",
    "use_cases": [
      "Steam inventory systems",
      "In-game purchases",
      "Item trading",
      "Crafting systems",
      "Steam Market integration"
    ],
    "related_skills": [
