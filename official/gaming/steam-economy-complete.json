          "payment",
          "checkout",
          "wallet",
          "transaction"
        ],
        "economy_api": [
          "ISteamEconomy",
          "economy",
          "asset",
          "context"
        ],
        "inventory_webapi": [
          "IInventoryService",
          "webapi",
          "web api",
          "http"
        ],
        "trading": [
          "trading",
          "trade",
          "exchange",
          "market"
        ],
        "crafting": [
          "crafting",
          "recipe",
