{
  "name": "ollama",
  "description": "Complete Ollama knowledge from official documentation. Use when running LLMs locally. Covers model pulling, chatting, custom models, Modelfile, and REST API.",
  "version": "1.0.0",
  "base_url": "https://github.com/ollama/ollama/blob/main/README.md",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://github.com/ollama/ollama/blob/main/README.md",
      "start_urls": [
        "https://github.com/ollama/ollama/blob/main/README.md",
        "https://github.com/ollama/ollama/blob/main/docs/API.md",
        "https://github.com/ollama/ollama/blob/main/docs/modelfile.md",
        "https://ollama.com/library"
      ],
      "selectors": {
        "main_content": "article, main, .readme",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/ollama/ollama/blob/main/",
          "/ollama/ollama/blob/main/docs/",
          "/ollama/ollama/blob/main/docs/API.md",
          "/ollama/ollama/blob/main/docs/modelfile.md"
        ],
        "exclude": [
          "/ollama/ollama/blob/main/CHANGELOG.md"
        ]
      },
      "categories": {
        "getting_started": [
          "README",
          "installation",
          "quickstart",
          "docker"
        ],
        "cli": [
          "ollama",
          "run",
          "pull",
          "list",
          "rm",
          "cp",
          "push"
        ],
        "modelfile": [
          "modelfile",
          "FROM",
          "PARAMETER",
          "TEMPLATE",
          "SYSTEM",
          "ADAPTER"
        ],
        "api": [
          "API",
          "generate",
          "chat",
          "embeddings",
          "create",
          "tags"
        ],
        "models": [
          "library",
          "llama3",
          "mistral",
          "codellama",
          "phi",
          "gemma"
        ],
        "parameters": [
          "PARAMETER",
          "temperature",
          "top_p",
          "top_k",
          "num_ctx",
          "seed"
        ],
        "importing": [
          "import",
          "gguf",
          "safetensors",
          "pytorch"
        ],
        "gpu": [
          "gpu",
          "cuda",
          "rocm",
          "metal"
        ],
        "troubleshooting": [
          "troubleshooting",
          "faq",
          "common-issues"
        ],
        "integrations": [
          "integrations",
          "langchain",
          "llamaindex",
          "open-webui"
        ]
      },
      "rate_limit": 0.3,
      "max_pages": 150
    }
  ],
  "metadata": {
    "author": "Ollama",
    "language": "Go",
    "framework_type": "Local LLM Runtime",
    "use_cases": [
      "Local LLM deployment",
      "Private AI",
      "Model experimentation",
      "Edge AI",
      "Offline inference"
    ],
    "related_skills": [
      "docker",
