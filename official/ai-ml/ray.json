{
  "name": "ray",
  "description": "Complete Ray knowledge from official documentation. Use when building distributed Python applications and scaling ML workloads. Covers tasks, actors, train, tune, serve, and data.",
  "version": "1.0.0",
  "base_url": "https://docs.ray.io/en/latest/",
