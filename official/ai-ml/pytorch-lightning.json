        "https://lightning.ai/docs/pytorch/stable/common/trainer.html"
      ],
      "selectors": {
        "main_content": "article, main",
        "title": "h1",
        "code_blocks": "pre code, pre"
      },
      "url_patterns": {
        "include": [
          "/stable/starter/",
          "/stable/common/",
          "/stable/advanced/",
          "/stable/api/"
