{
  "name": "pytorch-lightning",
  "description": "Complete PyTorch Lightning knowledge from official documentation. Use when structuring PyTorch code with best practices. Covers LightningModule, Trainer, callbacks, and distributed training.",
  "version": "1.0.0",
  "base_url": "https://lightning.ai/docs/pytorch/stable/",
  "sources": [
    {
      "type": "documentation",
      "base_url": "https://lightning.ai/docs/pytorch/stable/",
