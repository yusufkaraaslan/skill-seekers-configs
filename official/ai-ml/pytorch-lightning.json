        ],
        "loggers": [
          "common/loggers",
          "tensorboard",
          "wandb",
          "mlflow",
          "csv_logger"
        ],
        "accelerators": [
          "accelerators/gpu",
          "accelerators/tpu",
          "accelerators/ipu",
          "accelerators/hpu"
        ],
        "distributed": [
