          "vscode",
          "rstudio"
        ],
        "pipelines": [
          "components/pipelines",
          "sdk",
          "dsl",
          "components",
          "io"
        ],
        "katib": [
          "components/katib",
          "hyperparameter-tuning",
          "experiments",
          "algorithms"
        ],
        "training_operators": [
          "components/training",
          "tfjob",
          "pytorchjob",
          "xgboostjob",
          "mpi-operator"
        ],
        "serving": [
          "components/kserve",
          "inferenceservice",
          "transformer",
          "explainer"
        ],
        "feature_store": [
          "components/feature-store",
          "feast",
          "features"
        ],
        "metadata": [
          "components/metadata",
          "ml-metadata",
          "lineage",
          "artifacts"
        ],
        "fairing": [
          "external-add-ons/fairing",
          "build",
