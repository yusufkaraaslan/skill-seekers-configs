{
  "name": "kubeflow",
  "description": "Complete Kubeflow knowledge from official documentation. Use when deploying ML workflows on Kubernetes. Covers notebooks, pipelines, training, serving, and hyperparameter tuning.",
  "version": "1.0.0",
  "base_url": "https://www.kubeflow.org/docs/",
