        "streaming": [
          "api/messages-streaming",
          "streaming",
          "sse",
          "delta"
        ],
        "prompt_engineering": [
          "docs/prompt-engineering",
          "prompt-examples",
          "best-practices"
        ],
        "tokens": [
          "api/tokens",
          "token-counting",
          "context-window",
          "max-tokens"
        ],
